{
  // Используйте IntelliSense, чтобы узнать о возможных атрибутах.
  // Наведите указатель мыши, чтобы просмотреть описания существующих атрибутов.
  // Для получения дополнительной информации посетите: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // F5      — запуск С отладкой (точки останова работают)
  // Ctrl+F5 — запуск БЕЗ отладки (тот же сервер, без остановок)
  // Полностью без debugpy сервер запускается задачей из tasks.json: Ctrl+Shift+B
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: runserver 8001 (отладка)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\manage.py",
      "args": ["runserver", "8001"],
      "django": true,
      "console": "integratedTerminal",
      "autoStartBrowser": false
    }
  ]
}
