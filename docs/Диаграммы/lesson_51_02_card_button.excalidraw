          "source": "def post_card_fragment(request, post_slug):\n    time.sleep(2)\n    for post in POSTS:\n        if post[\"slug\"] == post_slug and post[\"is_published\"]:\n            return render(request,\n                \"blog/post_card_include.html\",\n                {\"post\": post})\n    raise Http404(404)",
