      "text": "POST_CONTEXT = {\n    \"title\": \"Django 6.1\",\n    \"text\": \"Django 6.1 - это круто!\",\n    \"hash_tags\": [\n        \"#django\", \"#python\", \"#web\"\n    ],\n    \"views\": 100500,\n    \"authors\": {\n        \"main\": \"Mr. Robot\",\n        \"secondary\": \"Тётя Варя\",\n    },\n    \"post\": post,\n}",
